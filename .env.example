# Google Apps Script web app URL (ends with /exec).
# Deploy apps-script/booking.gs as a Web App under jechnotechno@gmail.com,
# then paste the /exec URL here into a local .env file (which is git-ignored).
VITE_BOOKING_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Delad hemlighet mot spam. Måste vara identisk med SHARED_SECRET i
# apps-script/booking.gs. Värdet hamnar i klientkoden — det är ett spamfilter,
# inte autentisering. Generera t.ex. med: openssl rand -hex 24
VITE_BOOKING_TOKEN=
